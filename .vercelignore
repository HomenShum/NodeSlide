# Keep production uploads focused on the Vite web app.

# Every file under api/ becomes a public serverless function. The route's own
# tests are not routes: without this, `api/share.test.ts` and
# `api/share.http.test.ts` deploy as /api/share.test and /api/share.http.test.
api/*.test.ts

node_modules/
dist/
.git/
.convex/
.tmp/
.cache/
.playwright-mcp/
playwright-report/
test-results/
coverage/
artifacts/
outputs/
.qa/
benchmarks/
skills/

# Local recordings and release evidence are uploaded to GitHub Releases, not Vercel.
runs/

# MCP/server package is distributed separately from the hosted web app.
mcp/

# Local-only editor and generated files.
.vscode/
.idea/
*.log
tsconfig.tsbuildinfo
*.tgz
!public/downloads/parity-studio-mcp-*.tgz
!vendor/nodebook/*.tgz

# Local secrets and Vercel state.
.env
.env.local
.env.*.local
.vercel/
.vercel.env.tmp
