  "traceFunction": "function realTraces() {\n  let entries;\n  try {\n    entries = readdirSync('.tmp', { withFileTypes: true });\n  } catch (error) {\n    if (error.code === 'ENOENT') return [];\n    throw error;\n  }\n  const traces = [];\n  function visit(directory, children) {\n    for (const entry of children) {\n      const path = join(directory, entry.name);\n      if (entry.isDirectory()) visit(path, readdirSync(path, { withFileTypes: true }));\n      else if (entry.isFile() && entry.name === 'trace.zip') traces.push(path);\n    }\n  }\n  visit('.tmp', entries);\n  return traces.sort();\n}\n\n",
