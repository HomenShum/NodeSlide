{
  "name": "@nodeslide/recipelang",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "recipelang": "./dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
