# Local release-candidate and superseded Gym evidence (final artifacts stay tracked).
outputs/artifact-atlas-v3/*-rc1.pptx
outputs/artifact-atlas-v3/*-rc1-montage.png
outputs/artifact-atlas-v3/*-rc1-rendered/
outputs/artifact-atlas-v3/*.inspect.ndjson

# TypeScript incremental build cache
*.tsbuildinfo
.vercel

# Local proof runner streams; sanitized JSON receipts may be committed.
artifacts/**/*.stdout.log
artifacts/**/*.stderr.log

# The conformance receipt binds the commit and worktree state of one local run. Committing it
# would dirty the tree, so the next run would report worktreeClean: false forever.
artifacts/conformance/proof-receipt.json

# Playback canary screen captures — evidence is the signature JSON, not 34MB of PNGs.
outputs/**/playback-frames/
.env*.local

# Disposable production dogfood outputs. The scenario corpus and concise proof
# report are tracked; generated decks, renders, receipts, and provider logs are local evidence.
evidence/visual-logic-campaign/before/
evidence/visual-logic-campaign/after/
evidence/visual-logic-campaign/*.pid
evidence/visual-logic-campaign/*.log
evidence/visual-logic-campaign/*-results.json
